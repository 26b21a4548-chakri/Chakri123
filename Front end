      "cell_type": "code",
      "source": [
        "\"\"\"\n",
        "Bridge Load Distribution Calculator - single-file backend\n",
        "Model: A X = B   (NumPy solves, SymPy gives exact determinant and inverse)\n",
        "\n",
        "Install:  pip install fastapi uvicorn numpy sympy pydantic\n",
        "Run:      uvicorn main:app --reload\n",
        "Docs:     http://127.0.0.1:8000/docs\n",
        "\"\"\"\n",
        "\n",
        "from __future__ import annotations\n",
        "\n",
        "import math\n",
        "from typing import Any, Dict, List, Literal, Sequence\n",
        "\n",
        "import numpy as np\n",
        "import sympy as sp\n",
        "from fastapi import FastAPI, HTTPException, Request\n",
        "from fastapi.exceptions import RequestValidationError\n",
        "from fastapi.responses import JSONResponse\n",
        "from pydantic import BaseModel, Field\n",
        "from starlette.exceptions import HTTPException as StarletteHTTPException\n",
        "\n",
        "# ==========================================================================\n",
        "# CONSTANTS\n",
        "# ==========================================================================\n",
        "\n",
        "# Coefficient matrix A of the system AX = B (3 supports -> 3x3 matrix)\n",
        "MATRIX_A: List[List[int]] = [\n",
        "    [2, -1, 0],\n",
        "    [-1, 2, -1],\n",
        "    [0, -1, 2],\n",
        "]\n",
        "\n",
        "NUM_SUPPORTS: int = len(MATRIX_A)\n",
        "DECIMALS: int = 6  # rounding used for all numbers returned by the API\n",
        "\n",
        "# Default data from the project specification\n",
        "DEFAULT_DATA: Dict[str, Any] = {\n",
        "    \"supports\": [0, 10, 20],\n",
        "    \"loads\": [100, 150, 80],\n",
        "    \"load_positions\": [4, 10, 16],\n",
        "    \"truck_index\": 1,\n",
        "    \"truck_new_position\": 14,\n",
        "}\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# CUSTOM EXCEPTIONS\n",
        "# ==========================================================================\n",
        "\n",
        "class InputValidationError(ValueError):\n",
        "    \"\"\"Raised when the user supplied input is invalid.\"\"\"\n",
        "\n",
        "\n",
        "class SingularMatrixError(ArithmeticError):\n",
        "    \"\"\"Raised when matrix A is singular (determinant = 0).\"\"\"\n",
        "\n",
        "\n",
        "class CalculationError(RuntimeError):\n",
        "    \"\"\"Raised when a numerical computation fails.\"\"\"\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# PYDANTIC MODELS (request / response)\n",
        "# ==========================================================================\n",
        "\n",
        "class CalculationRequest(BaseModel):\n",
        "    \"\"\"Input for POST /calculate. All fields are required.\"\"\"\n",
        "\n",
        "    supports: List[float] = Field(\n",
        "        ..., description=\"Support positions in metres (exactly 3, increasing).\",\n",
        "        examples=[[0, 10, 20]],\n",
        "    )\n",
        "    loads: List[float] = Field(\n",
        "        ..., description=\"Loads in kN (non-negative).\",\n",
        "        examples=[[100, 150, 80]],\n",
        "    )\n",
        "    load_positions: List[float] = Field(\n",
        "        ..., description=\"Position of each load in metres (same length as loads).\",\n",
        "        examples=[[4, 10, 16]],\n",
        "    )\n",
        "    truck_index: int = Field(\n",
        "        ..., description=\"0-based index (in `loads`) of the load that is the truck.\",\n",
        "        examples=[1],\n",
        "    )\n",
        "    truck_new_position: float = Field(\n",
        "        ..., description=\"New position of the truck in metres.\",\n",
        "        examples=[14],\n",
        "    )\n",
        "\n",
        "\n",
        "class MatrixResult(BaseModel):\n",
        "    A: List[List[float]]\n",
        "    determinant: float\n",
        "    is_invertible: bool\n",
        "    inverse: List[List[float]]\n",
        "\n",
        "\n",
        "class StateResult(BaseModel):\n",
        "    B: List[float] = Field(..., description=\"Load vector [B1, B2, B3].\")\n",
        "    reactions: List[float] = Field(..., description=\"Support reactions X = A^-1 B.\")\n",
        "\n",
        "\n",
        "class TruckResult(BaseModel):\n",
        "    initial_position: float\n",
        "    new_position: float\n",
        "    movement: float\n",
        "\n",
        "\n",
        "class CalculationResponse(BaseModel):\n",
        "    status: Literal[\"success\"] = \"success\"\n",
        "    matrix: MatrixResult\n",
        "    before: StateResult\n",
        "    after: StateResult\n",
        "    truck: TruckResult\n",
        "    reaction_changes: List[float]\n",
        "    total_load: float\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# HELPERS\n",
        "# ==========================================================================\n",
        "\n",
        "def _clean(value: float) -> float:\n",
        "    \"\"\"Round a number and remove negative zero (-0.0 -> 0.0).\"\"\"\n",
        "    return round(float(value), DECIMALS) + 0.0\n",
        "\n",
        "\n",
        "def _clean_list(values: Sequence[float]) -> List[float]:\n",
        "    return [_clean(v) for v in values]\n",
        "\n",
        "\n",
        "def _clean_matrix(matrix: Sequence[Sequence[float]]) -> List[List[float]]:\n",
        "    return [_clean_list(row) for row in matrix]\n",
        "\n",
        "\n",
        "def _check_finite(name: str, values: Sequence[float]) -> None:\n",
        "    \"\"\"Every entry must be a real, finite number (no NaN / infinity).\"\"\"\n",
        "    for i, v in enumerate(values):\n",
        "        if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v):\n",
        "            raise InputValidationError(\n",
        "                f\"'{name}[{i}]' must be a finite number, got {v!r}.\"\n",
        "            )\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# INPUT VALIDATION\n",
        "# ==========================================================================\n",
        "\n",
        "def validate_inputs(\n",
        "    supports: Sequence[float],\n",
        "    loads: Sequence[float],\n",
        "    load_positions: Sequence[float],\n",
        "    truck_index: int,\n",
        "    truck_new_position: float,\n",
        ") -> None:\n",
        "    \"\"\"Validate all inputs; raise InputValidationError with a clear message.\"\"\"\n",
        "    if supports is None or loads is None or load_positions is None:\n",
        "        raise InputValidationError(\n",
        "            \"'supports', 'loads' and 'load_positions' are required.\"\n",
        "        )\n",
        "\n",
        "    # --- array lengths ---\n",
        "    if len(supports) != NUM_SUPPORTS:\n",
        "        raise InputValidationError(\n",
        "            f\"'supports' must contain exactly {NUM_SUPPORTS} values \"\n",
        "            f\"(matrix A is {NUM_SUPPORTS}x{NUM_SUPPORTS}); got {len(supports)}.\"\n",
        "        )\n",
        "    if len(loads) == 0:\n",
        "        raise InputValidationError(\"'loads' must contain at least one value.\")\n",
        "    if len(loads) != len(load_positions):\n",
        "        raise InputValidationError(\n",
        "            \"'loads' and 'load_positions' must have the same length \"\n",
        "            f\"(got {len(loads)} and {len(load_positions)}).\"\n",
        "        )\n",
        "\n",
        "    # --- numerical values ---\n",
        "    _check_finite(\"supports\", supports)\n",
        "    _check_finite(\"loads\", loads)\n",
        "    _check_finite(\"load_positions\", load_positions)\n",
        "    _check_finite(\"truck_new_position\", [truck_new_position])\n",
        "\n",
        "    if any(l < 0 for l in loads):\n",
        "        raise InputValidationError(\"'loads' must not contain negative values.\")\n",
        "\n",
        "    # --- supports must be strictly increasing ---\n",
        "    if any(supports[i] >= supports[i + 1] for i in range(len(supports) - 1)):\n",
        "        raise InputValidationError(\n",
        "            \"'supports' must be strictly increasing (e.g. [0, 10, 20]).\"\n",
        "        )\n",
        "\n",
        "    x1, x3 = supports[0], supports[-1]\n",
        "\n",
        "    # --- load positions must lie on the bridge ---\n",
        "    for i, p in enumerate(load_positions):\n",
        "        if not (x1 <= p <= x3):\n",
        "            raise InputValidationError(\n",
        "                f\"'load_positions[{i}]' = {p} is outside the bridge span \"\n",
        "                f\"[{x1}, {x3}].\"\n",
        "            )\n",
        "\n",
        "    # --- truck index ---\n",
        "    if isinstance(truck_index, bool) or not isinstance(truck_index, int):\n",
        "        raise InputValidationError(\"'truck_index' must be an integer.\")\n",
        "    if not (0 <= truck_index < len(loads)):\n",
        "        raise InputValidationError(\n",
        "            f\"'truck_index' = {truck_index} is invalid; it must be between 0 \"\n",
        "            f\"and {len(loads) - 1} (there are {len(loads)} loads).\"\n",
        "        )\n",
        "\n",
        "    # --- new truck position ---\n",
        "    if not (x1 <= truck_new_position <= x3):\n",
        "        raise InputValidationError(\n",
        "            f\"'truck_new_position' = {truck_new_position} is outside the \"\n",
        "            f\"bridge span [{x1}, {x3}].\"\n",
        "        )\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# MATRIX A: determinant, invertibility, inverse (SymPy - exact arithmetic)\n",
        "# ==========================================================================\n",
        "\n",
        "def get_matrix_A() -> sp.Matrix:\n",
        "    \"\"\"Return matrix A as an exact SymPy matrix.\"\"\"\n",
        "    return sp.Matrix(MATRIX_A)\n",
        "\n",
        "\n",
        "def calculate_determinant(A: sp.Matrix) -> sp.Expr:\n",
        "    \"\"\"Exact determinant of A.\"\"\"\n",
        "    return A.det()\n",
        "\n",
        "\n",
        "def is_invertible(determinant: sp.Expr) -> bool:\n",
        "    \"\"\"A square matrix is invertible if and only if det(A) != 0.\"\"\"\n",
        "    return determinant != 0\n",
        "\n",
        "\n",
        "def calculate_inverse(A: sp.Matrix) -> sp.Matrix:\n",
        "    \"\"\"Exact inverse of A using SymPy (raises SingularMatrixError if singular).\"\"\"\n",
        "    if not is_invertible(calculate_determinant(A)):\n",
        "        raise SingularMatrixError(\n",
        "            \"Matrix A is singular (determinant = 0); it cannot be inverted.\"\n",
        "        )\n",
        "    return A.inv()\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# LOAD VECTOR B\n",
        "# ==========================================================================\n",
        "\n",
        "def calculate_load_vector(\n",
        "    supports: Sequence[float],\n",
        "    loads: Sequence[float],\n",
        "    load_positions: Sequence[float],\n",
        ") -> List[float]:\n",
        "    \"\"\"\n",
        "    Build B = [B1, B2, B3] with x1 = first support and x3 = last support:\n",
        "\n",
        "        B1 = sum( load * (x3 - position) / (x3 - x1) )\n",
        "        B3 = sum( load * (position - x1) / (x3 - x1) )\n",
        "        B2 = total_load - B1 - B3\n",
        "    \"\"\"\n",
        "    x1, x3 = float(supports[0]), float(supports[-1])\n",
        "    span = x3 - x1\n",
        "    if span <= 0:\n",
        "        raise InputValidationError(\"Bridge span (x3 - x1) must be positive.\")\n",
        "\n",
        "    b1 = sum(w * (x3 - p) / span for w, p in zip(loads, load_positions))\n",
        "    b3 = sum(w * (p - x1) / span for w, p in zip(loads, load_positions))\n",
        "    total = float(sum(loads))\n",
        "    b2 = total - b1 - b3\n",
        "\n",
        "    return [b1, b2, b3]\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# SOLVING AX = B (NumPy)\n",
        "# ==========================================================================\n",
        "\n",
        "def solve_reactions(B: Sequence[float]) -> List[float]:\n",
        "    \"\"\"Solve A X = B with NumPy and return the support reactions X.\"\"\"\n",
        "    A_np = np.array(MATRIX_A, dtype=float)\n",
        "    B_np = np.array(B, dtype=float)\n",
        "    try:\n",
        "        X = np.linalg.solve(A_np, B_np)\n",
        "    except np.linalg.LinAlgError as exc:\n",
        "        raise SingularMatrixError(f\"Cannot solve AX = B: {exc}\") from exc\n",
        "    if not np.all(np.isfinite(X)):\n",
        "        raise CalculationError(\"The solution contains non-finite values.\")\n",
        "    return X.tolist()\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# TRUCK MOVEMENT AND REACTION CHANGES\n",
        "# ==========================================================================\n",
        "\n",
        "def move_truck(\n",
        "    load_positions: Sequence[float], truck_index: int, new_position: float\n",
        ") -> List[float]:\n",
        "    \"\"\"Return a copy of the load positions with the truck moved.\"\"\"\n",
        "    moved = list(load_positions)\n",
        "    moved[truck_index] = new_position\n",
        "    return moved\n",
        "\n",
        "\n",
        "def calculate_reaction_changes(\n",
        "    before: Sequence[float], after: Sequence[float]\n",
        ") -> List[float]:\n",
        "    \"\"\"Change in each support reaction = after - before.\"\"\"\n",
        "    return [a - b for a, b in zip(after, before)]\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# FULL PIPELINE\n",
        "# ==========================================================================\n",
        "\n",
        "def run_full_calculation(\n",
        "    supports: Sequence[float],\n",
        "    loads: Sequence[float],\n",
        "    load_positions: Sequence[float],\n",
        "    truck_index: int,\n",
        "    truck_new_position: float,\n",
        ") -> Dict[str, Any]:\n",
        "    \"\"\"Validate inputs, run every calculation and return a structured dict.\"\"\"\n",
        "    validate_inputs(supports, loads, load_positions, truck_index, truck_new_position)\n",
        "\n",
        "    # --- matrix analysis (SymPy) ---\n",
        "    A = get_matrix_A()\n",
        "    det = calculate_determinant(A)\n",
        "    invertible = is_invertible(det)\n",
        "    if not invertible:\n",
        "        raise SingularMatrixError(\n",
        "            \"Matrix A is singular (determinant = 0); the system has no unique solution.\"\n",
        "        )\n",
        "    A_inv = calculate_inverse(A)\n",
        "\n",
        "    # --- before truck movement ---\n",
        "    B_before = calculate_load_vector(supports, loads, load_positions)\n",
        "    reactions_before = solve_reactions(B_before)\n",
        "\n",
        "    # --- after truck movement ---\n",
        "    initial_position = float(load_positions[truck_index])\n",
        "    new_positions = move_truck(load_positions, truck_index, truck_new_position)\n",
        "    B_after = calculate_load_vector(supports, loads, new_positions)\n",
        "    reactions_after = solve_reactions(B_after)\n",
        "\n",
        "    # --- changes ---\n",
        "    changes = calculate_reaction_changes(reactions_before, reactions_after)\n",
        "\n",
        "    return {\n",
        "        \"status\": \"success\",\n",
        "        \"matrix\": {\n",
        "            \"A\": _clean_matrix(MATRIX_A),\n",
        "            \"determinant\": _clean(float(det)),\n",
        "            \"is_invertible\": bool(invertible),\n",
        "            \"inverse\": _clean_matrix(A_inv.tolist()),\n",
        "        },\n",
        "        \"before\": {\n",
        "            \"B\": _clean_list(B_before),\n",
        "            \"reactions\": _clean_list(reactions_before),\n",
        "        },\n",
        "        \"after\": {\n",
        "            \"B\": _clean_list(B_after),\n",
        "            \"reactions\": _clean_list(reactions_after),\n",
        "        },\n",
        "        \"truck\": {\n",
        "            \"initial_position\": _clean(initial_position),\n",
        "            \"new_position\": _clean(truck_new_position),\n",
        "            \"movement\": _clean(truck_new_position - initial_position),\n",
        "        },\n",
        "        \"reaction_changes\": _clean_list(changes),\n",
        "        \"total_load\": _clean(sum(loads)),\n",
        "    }\n",
        "\n",
        "\n",
        "# ==========================================================================\n",
        "# FASTAPI APPLICATION\n",
        "# ==========================================================================\n",
        "\n",
        "app = FastAPI(\n",
        "    title=\"Bridge Load Distribution Calculator\",\n",
        "    description=(\n",
        "        \"Solves AX = B for the support reactions of a 3-support bridge and \"\n",
        "        \"reports how the reactions change when a truck moves.\"\n",
        "    ),\n",
        "    version=\"1.0.0\",\n",
        ")\n",
        "\n",
        "\n",
        "# --- Error handlers: every error is returned as {\"status\": \"error\", ...} ---\n",
        "\n",
        "@app.exception_handler(RequestValidationError)\n",
        "async def validation_error_handler(request: Request, exc: RequestValidationError):\n",
        "    \"\"\"Missing fields, wrong types, malformed JSON, etc.\"\"\"\n",
        "    details = []\n",
        "    for err in exc.errors():\n",
        "        loc = [str(part) for part in err.get(\"loc\", ()) if part != \"body\"]\n",
        "        details.append({\n",
        "            \"field\": \".\".join(loc) if loc else \"body\",\n",
        "            \"message\": err.get(\"msg\", \"Invalid value\"),\n",
        "        })\n",
        "    return JSONResponse(\n",
        "        status_code=422,\n",
        "        content={\n",
        "            \"status\": \"error\",\n",
        "            \"message\": \"Missing or invalid input. See 'details'.\",\n",
        "            \"details\": details,\n",
        "        },\n",
        "    )\n",
        "\n",
        "\n",
        "@app.exception_handler(StarletteHTTPException)\n",
        "async def http_error_handler(request: Request, exc: StarletteHTTPException):\n",
        "    return JSONResponse(\n",
        "        status_code=exc.status_code,\n",
        "        content={\"status\": \"error\", \"message\": str(exc.detail)},\n",
        "    )\n",
        "\n",
        "\n",
        "# --- Routes ---\n",
        "\n",
        "@app.get(\"/\", tags=[\"info\"])\n",
        "def root() -> Dict[str, str]:\n",
        "    \"\"\"Health check / project info.\"\"\"\n",
        "    return {\n",
        "        \"project\": \"Bridge Load Distribution Calculator\",\n",
        "        \"status\": \"running\",\n",
        "        \"docs\": \"/docs\",\n",
        "    }\n",
        "\n",
        "\n",
        "@app.get(\"/default-data\", tags=[\"info\"])\n",
        "def default_data() -> Dict[str, Any]:\n",
        "    \"\"\"Return the default input from the project specification.\"\"\"\n",
        "    return DEFAULT_DATA\n",
        "\n",
        "\n",
        "@app.post(\"/calculate\", response_model=CalculationResponse, tags=[\"calculation\"])\n",
        "def calculate(request: CalculationRequest) -> Dict[str, Any]:\n",
        "    \"\"\"Compute reactions before and after the truck moves.\"\"\"\n",
        "    try:\n",
        "        return run_full_calculation(\n",
        "            supports=request.supports,\n",
        "            loads=request.loads,\n",
        "            load_positions=request.load_positions,\n",
        "            truck_index=request.truck_index,\n",
        "            truck_new_position=request.truck_new_position,\n",
        "        )\n",
        "    except InputValidationError as exc:\n",
        "        raise HTTPException(status_code=422, detail=str(exc))\n",
        "    except SingularMatrixError as exc:\n",
        "        raise HTTPException(status_code=422, detail=str(exc))\n",
        "    except CalculationError as exc:\n",
        "        raise HTTPException(status_code=500, detail=f\"Calculation error: {exc}\")\n",
        "    except Exception as exc:  # last-resort safety net\n",
        "        raise HTTPException(\n",
        "            status_code=500, detail=f\"Unexpected calculation error: {exc}\"\n",
        "        )"
      ],
